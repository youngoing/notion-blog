---
import type { PaginationLink } from "@/types";
import Icon from "@/components/ui/Icon.astro";

interface Props {
	prevUrl?: PaginationLink;
	nextUrl?: PaginationLink;
}

const { prevUrl, nextUrl } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<nav class="pagination-nav">
			{prevUrl && (
				<a class="prev-link inline-flex items-center gap-1" href={prevUrl.url} data-astro-prefetch>
					{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}
					<Icon
						class="pagination-prev-icon h-5 w-5"
						name={"before"}
						aria-hidden="true"
						focusable="false"
					/>
					{prevUrl.text ? prevUrl.text : <span data-language-zh="上一页" data-language-en="Previous">上一页</span>}
				</a>
			)}
			{nextUrl && (
				<a class="next-link inline-flex items-center gap-1" href={nextUrl.url} data-astro-prefetch>
					{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}
					{nextUrl.text ? nextUrl.text : <span data-language-zh="下一页" data-language-en="Next">下一页</span>}
					<Icon
						class="pagination-next-icon h-5 w-5"
						name={"next"}
						aria-hidden="true"
						focusable="false"
					/>
				</a>
			)}
		</nav>
	)
}
