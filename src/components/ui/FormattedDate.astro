---
import type { HTMLAttributes } from "astro/types";
import { getDateTimeValue, getFormattedDate } from "@/utils";

type Props = HTMLAttributes<"time"> & {
	date: string | number | Date;
	dateTimeOptions?: Intl.DateTimeFormatOptions;
};

const { date, dateTimeOptions, ...attrs } = Astro.props;

const postDate = getFormattedDate(date, dateTimeOptions);
const dateValue = getDateTimeValue(date);
const formatOptions = JSON.stringify({
	...(dateTimeOptions || { day: "numeric", month: "short", year: "numeric" }),
	timeZone: /^\d{4}-\d{2}-\d{2}$/.test(String(date)) ? "UTC" : undefined,
});
---

<time datetime={dateValue} data-date-value={dateValue} data-date-options={formatOptions} {...attrs}>
	{postDate}
</time>
